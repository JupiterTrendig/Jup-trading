let solPriceCache = {
  price: 0,
  timestamp: 0
};
const PRICE_CACHE_TTL = 60000; // 1 minute

// Fallback RPC endpoints
const RPC_ENDPOINTS = [
  process.env.SOLANA_RPC || 'https://api.mainnet-beta.solana.com',
